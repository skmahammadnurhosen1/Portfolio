# Environment configuration for Noor Admin Panel & Backend
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
NODE_ENV=development

# Optional Firebase Service Account credentials (if connecting to live Google Cloud / Firebase project)
# You can provide either individual environment variables or path to serviceAccountKey.json
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=

# Path to service account json file (optional alternative)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Initial root admin credentials for first boot if database is unseeded
INITIAL_ADMIN_EMAIL=noor@example.com
INITIAL_ADMIN_PASSWORD=AdminSecure2025!
